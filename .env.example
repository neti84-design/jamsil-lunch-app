# Supabase 프로젝트 > Settings > API 에서 복사
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# (선택) Supabase 미연결(로컬 저장) 상태에서 쓸 관리자 비밀번호. 기본값 admin
# Supabase 연결 시에는 app_config 테이블의 admin_token 을 씁니다 (supabase/schema.sql)
VITE_ADMIN_KEY=admin

# (선택) 카카오톡 공유 — 큰 미리보기 대신 글 + [웹앱 바로가기] 버튼으로 보낸다.
# Kakao Developers > 내 애플리케이션 > 앱 키 > JavaScript 키. 플랫폼 > Web 에 사이트 도메인(https://jamsim.vercel.app) 등록 필요
VITE_KAKAO_JS_KEY=
